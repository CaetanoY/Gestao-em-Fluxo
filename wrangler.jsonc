{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frota-modelo",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./web",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "frota-modelo",
      "database_id": "SUBSTITUA_PELO_ID_DA_SUA_BASE",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PUBLIC_SUBMISSIONS": "true"
  }
}
